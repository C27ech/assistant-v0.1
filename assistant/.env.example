# ===== DeepSeek API（复制本文件为 .env 后填入真实 key；.env 已在 .gitignore 里）=====
# 三把 key 可以都填成同一个账号的，也可以分账号（便于分别计费/限流隔离）
DEEPSEEK_API_KEY_DECISION=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY_MONITOR=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY_CODER=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 任何 OpenAI 兼容端点都可以（换成本地推理服务也行）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DECISION_MODEL=deepseek-v4-flash
MONITOR_MODEL=deepseek-v4-flash
CODER_MODEL=deepseek-v4-flash

# ===== 豆包（火山方舟 Ark）：可选，配了之后派活可选豆包模型 =====
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 微信（WeChatFerry）=====
# host 留空表示本地启动 RPC；端口默认 10086（接收消息占用 10087）
WCF_HOST=
WCF_PORT=10086
WCF_DEBUG=false
# block=true 会阻塞等待微信 PC 客户端登录
WCF_BLOCK=true

# ===== 渠道选择 =====
# wechat（个人微信 WeChatFerry）/ wecom（企业微信）/ qq（QQ OneBot）
CHANNEL=qq

# ===== 企业微信（自建应用 + 回调）=====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_PORT=8000

# ===== QQ（OneBot / NapCat）=====
# NapCat 反向 WebSocket 地址（本应用作为客户端连入）
QQ_ONEBOT_URL=ws://127.0.0.1:3001

# ===== 用户识别：备注名 -> 用户ID（逗号分隔，多个备注可指向同一用户）=====
# 例：USER_MAP=老板:boss,同事:colleague
USER_MAP=

# ===== 使用者白名单（重要！）=====
# 只有名单里的账号能指挥助手；不在名单里的私聊会被静默忽略（不回、不入库，只记一行日志）。
# 留空 = 任何人都能指挥她，尤其是给了她读文件/操作桌面权限之后非常危险。
# QQ 渠道填 QQ 号；微信渠道填 wxid；多个用逗号或空格分隔。
ALLOWED_USERS=

# ===== 存储 =====
DB_PATH=assistant.db

# ===== 记忆（语义检索）=====
# 每轮从历史里召回多少条「与当前话题相关」的旧消息（越大越记事儿，也越费 token）
MEMORY_RETRIEVAL_K=30

# ===== 决策AI =====
# 每轮最多工具调用轮数（工具越多、任务越复杂，就该调越大）
DECISION_MAX_ITER=200

# ===== 主动汇报策略 =====
NOTIFY_ON_START=true
NOTIFY_ON_STUCK=true
NOTIFY_ON_DONE=true
